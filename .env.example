# AI Dataset Explorer — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to version control

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (for NextAuth provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini — get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Kaggle — get credentials at https://www.kaggle.com/settings (API section)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face — get token at https://huggingface.co/settings/tokens
HUGGING_FACE_TOKEN=

# Debug (set false in production)
DEBUG_API_TRACE=false

# Mock mode (set false for live API usage)
USE_MOCK_AI=false